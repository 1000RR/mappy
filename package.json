{
  "name": "mappy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-valhalla.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/main.ts",
    "build": "tsc -p tsconfig.json && vite build && node scripts/finalize-sw.mjs && tsc -p server/tsconfig.json",
    "start": "node dist-server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "data:maps": "node scripts/build-map-packs.mjs",
    "data:search": "node scripts/build-search-index.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@protomaps/basemaps": "^5.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "valhalla-browser": "0.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
